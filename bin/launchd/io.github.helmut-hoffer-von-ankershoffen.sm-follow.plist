<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  The sm release follower on the Mac mini: the Mini installs what a user installs. Every 5 minutes it reads the Latest
  GitHub release of steuermaschine (Latest only after the release run's clean-container acceptance), checks the Gate
  review of that tag's merge, takes the PyPI wheels of steuermaschine and steuermaschine-heinzel at that version (each
  equal by sha256 to the release asset), installs them into ~/Code/steuermaschine-stable/releases/vX, smokes, switches
  `current` between two admission or release steps (bin/promote_lib.sh of the release) and restarts the launchd loops
  that run the stable sm. Its own code is ~/Code/steuermaschine-follow, checked out at the release tag on every run.
  Install once: `gh repo clone helmut-hoffer-von-ankershoffen/steuermaschine ~/Code/steuermaschine-follow`, copy this
  file to ~/Library/LaunchAgents, replace USER, `launchctl bootstrap gui/$(id -u) PATH`. It must not name the stable sm:
  the follower never restarts itself. Rollback: bin/rollback. bin/promote stays the fallback until three clean releases.
-->
<plist version="1.0">
<dict>
  <key>Label</key><string>io.github.helmut-hoffer-von-ankershoffen.sm-follow</string>
  <key>ProgramArguments</key>
  <array>
    <string>/opt/homebrew/bin/python3</string>
    <string>/Users/USER/Code/steuermaschine-follow/bin/release_ci.py</string>
    <string>follow</string>
  </array>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key><string>/Users/USER/.local/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    <key>HOME</key><string>/Users/USER</string>
  </dict>
  <key>StartInterval</key><integer>300</integer>
  <key>RunAtLoad</key><true/>
  <key>StandardOutPath</key><string>/Users/USER/Library/Logs/sm-follow.log</string>
  <key>StandardErrorPath</key><string>/Users/USER/Library/Logs/sm-follow.log</string>
</dict>
</plist>
